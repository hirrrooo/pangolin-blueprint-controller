# 1. Mandatory Newt tunnel credentials (Namespace: pangolin)
apiVersion: v1
kind: Secret
metadata:
  name: newt-auth
  namespace: pangolin
type: Opaque
stringData:
  PANGOLIN_ENDPOINT: https://app.pangolin.net # or your self-hosted instance (e.g. https://pangolin.example.com)
  NEWT_ID: your-newt-site-id
  NEWT_SECRET: your-newt-site-secret
---
# 2. Optional reusable policy Secret (Namespace: pangolin-policies)
# Only required if any of your Services specify `pangolin.net/policy: authenticated-members`
apiVersion: v1
kind: Secret
metadata:
  name: authenticated-members
  namespace: pangolin-policies
  labels:
    pangolin.net/public-policy: "true"
type: pangolin.net/public-policy
stringData:
  name: Authenticated Members
  sso: "true"
  sso-roles: '["Member", "DevOps"]'
  # password: "optional-shared-password"
  # pincode: "012345"
  # basic-auth-user: "demo"
  # basic-auth-password: "demo-password"
